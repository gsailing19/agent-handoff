{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/agent-handoff/scripts/hook-validate-handoff.sh",
            "timeout": 15,
            "async": false,
            "statusMessage": "Validating handoff file..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/agent-handoff/scripts/hook-validate-handoff.sh",
            "timeout": 15,
            "async": false,
            "statusMessage": "Validating handoff file (Bash)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/agent-handoff/scripts/pre-agent-handoff-check.sh",
            "timeout": 10,
            "async": false,
            "statusMessage": "Checking Agent handoff instructions..."
          }
        ]
      }
    ]
  }
}
